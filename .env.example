# Copy to .env.local. Never commit real secrets.
# PostgreSQL connection string. Use a dedicated database per environment.
DATABASE_URL=
# Set DATABASE_SSL=disable only for local PostgreSQL without TLS.
DATABASE_SSL=
DB_POOL_MAX=5

# OTP security: generate a random secret with at least 32 characters.
OTP_PEPPER=
# Resend email delivery. Use a verified sender domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Vivaah <auth@your-verified-domain.example>

# Bump when consent text or scope definitions change.
CONSENT_POLICY_VERSION=v1

# Never use a fixed OTP in production. No bypass or test OTP is implemented.
